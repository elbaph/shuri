{
  "name": "shuri",
  "displayName": "Shuri: Code & Soul",
  "description": "👁️ View synced Spotify lyrics in the Explorer view",
  "publisher": "o-p",
  "version": "0.2.0",
  "engines": {
    "vscode": "^1.123.0"
  },
  "icon": "assets/logo.jpeg",
  "categories": [
    "Other"
  ],
  "main": "./out/extension.js",
  "repository": {
    "type": "git",
    "url": "https://github.com/elbaph/shuri.git"
  },
  "contributes": {
    "configuration": {
      "title": "Shuri",
      "properties": {
        "shuri.port": {
          "type": "number",
          "default": 5566,
          "minimum": 1024,
          "maximum": 65535,
          "description": "Port used for the Spotify OAuth callback."
        },
        "shuri.tracksCacheMaxSize": {
          "type": "number",
          "default": 10,
          "minimum": 1,
          "maximum": 9007199254740991,
          "description": "Maximum cache size for tracks."
        },
        "shuri.songTitle": {
          "type": "boolean",
          "default": true,
          "description": "Toggle the song title in the lyrics panel."
        },
        "shuri.songIcon": {
          "type": "boolean",
          "default": true,
          "description": "Toggle the song icon in the lyrics panel."
        },
        "shuri.songArtists": {
          "type": "boolean",
          "default": true,
          "description": "Toggle the song artists in the lyrics panel."
        }
      }
    },
    "commands": [
      {
        "command": "shuri.lyrics",
        "title": "Show Spotify Lyrics via Shuri"
      },
      {
        "command": "shuri.logout",
        "title": "Logout from Shuri"
      },
      {
        "command": "shuri.tracksCacheMaxSize",
        "title": "Set Tracks Cache Max Size"
      },
      {
        "command": "shuri.port",
        "title": "Set Spotify OAuth Callback Port"
      },
      {
        "command": "shuri.songTitle",
        "title": "Toggle Song Title"
      },
      {
        "command": "shuri.songIcon",
        "title": "Toggle Song Icon"
      },
      {
        "command": "shuri.songArtists",
        "title": "Toggle Song Artists"
      }
    ],
    "views": {
      "explorer": [
        {
          "id": "shuri.lyricsView",
          "icon": "assets/icon.png",
          "name": "Shuri Lyrics",
          "type": "webview"
        }
      ]
    },
    "problemMatchers": [
      {
        "name": "esbuild-watch",
        "label": "esbuild watch",
        "owner": "typescript",
        "source": "esbuild",
        "applyTo": "closedDocuments",
        "fileLocation": [
          "relative",
          "${workspaceFolder}"
        ],
        "pattern": [
          {
            "regexp": "^\\s*✘ \\[ERROR\\] (.*)$",
            "message": 1
          },
          {
            "regexp": "^\\s*(.*):(\\d+):(\\d+):$",
            "file": 1,
            "line": 2,
            "column": 3
          }
        ],
        "background": {
          "activeOnStart": true,
          "beginsPattern": "^\\[watch\\] build started$",
          "endsPattern": "^\\[watch\\] build finished$"
        }
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "npm run bundle",
    "compile": "npm run check-types && npm run lint && node esbuild.js",
    "bundle": "npm run check-types && npm run lint && node esbuild.js --production",
    "check-types": "tsc --noEmit -p ./",
    "watch:esbuild": "node esbuild.js --watch",
    "watch:tsc": "tsc --noEmit --watch -p ./",
    "watch": "npm run watch:esbuild & npm run watch:tsc",
    "pretest": "npm run compile",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check 'src/**/*.{ts,js}'",
    "test": "vscode-test",
    "package": "vsce package -o shuri-dev.vsix"
  },
  "devDependencies": {
    "@trivago/prettier-plugin-sort-imports": "^6.0.2",
    "@types/mocha": "^10.0.10",
    "@types/node": "24.x",
    "@types/node-fetch": "^2.6.13",
    "@types/vscode": "^1.123.0",
    "@typescript-eslint/eslint-plugin": "^8.41.0",
    "@typescript-eslint/parser": "^8.41.0",
    "@vscode/test-cli": "^0.0.11",
    "@vscode/test-electron": "^2.5.2",
    "@vscode/vsce": "^3.9.2",
    "esbuild": "^0.24.2",
    "eslint": "^9.34.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.4",
    "prettier": "^3.9.6",
    "typescript": "^5.8.3"
  },
  "dependencies": {
    "lru-cache": "^7.18.3",
    "node-fetch": "^2.7.0",
    "ts-treemap": "^1.1.0",
    "tslib": "^2.8.1"
  },
  "license": "Unlicense"
}
